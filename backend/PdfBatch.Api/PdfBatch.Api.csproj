<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="PdfSharpCore" Version="1.3.67" />
    <PackageReference Include="Polybioz.HtmlRenderer.PdfSharp.Core" Version="1.1.0" />
    <!-- The templates are text/table only; override the vulnerable legacy image dependency.
         PdfSharpCore's legacy image-loading APIs require an adapter before adding images. -->
    <PackageReference Include="SixLabors.ImageSharp" Version="3.2.0" />
  </ItemGroup>
</Project>
